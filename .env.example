# Copy this file to .env and replace the values. Never commit .env.
WORKEANLY_SQL_SERVER=localhost
WORKEANLY_SQL_DATABASE=WORKEANLY_DB
WORKEANLY_SQL_USERNAME=your_username
WORKEANLY_SQL_PASSWORD=your_password
# Example: ODBC Driver 18 for SQL Server
WORKEANLY_SQL_DRIVER=ODBC Driver 18 for SQL Server
